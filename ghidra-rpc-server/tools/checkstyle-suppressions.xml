<?xml version="1.0"?>
<!-- Checkstyle suppressions for ghidra-rpc-server (loaded by tools/checkstyle.xml). -->
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>

  <!-- Intentionally empty.

       This file used to exempt long lines by LINE NUMBER, which went stale
       with every edit above them (and `make lint` then failed on lines
       nobody had touched). Prefer, in this order:
         1. fixing the line;
         2. a pattern in tools/checkstyle.xml (the handler registration table
            in RpcServer.java is exempted from LineLength that way);
         3. a whole-file <suppress checks="..." files="..."/> here, without
            a `lines=` attribute. -->

</suppressions>
